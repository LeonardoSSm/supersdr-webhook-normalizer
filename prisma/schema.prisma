generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id          String   @id @default(uuid())
  provider    String
  externalId  String?
  from        String?
  to          String?
  body        String?
  rawPayload  Json
  receivedAt  DateTime
  createdAt   DateTime @default(now())

  @@index([provider])
  @@index([externalId])
  @@index([receivedAt])
}