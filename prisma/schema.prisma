generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id                String   @id @default(cuid())
  provider          String
  providerMessageId String
  instanceId        String?
  fromPhone         String
  toPhone           String?
  contactName       String?
  direction         String
  messageType       String
  text              String?
  timestamp         DateTime
  rawPayload        Json
  intent            String?
  intentScore       Float?
  intentModel       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerMessageId])
  @@index([provider])
  @@index([fromPhone])
  @@index([timestamp])
  @@map("messages")
}